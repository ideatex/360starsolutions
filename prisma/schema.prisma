generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "debian-openssl-1.1.x", "rhel-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SHAREHOLDER
  ADMIN
  SUPER_ADMIN
}

enum AccountType {
  ZERO_CONTRIBUTION
  CONTRIBUTION
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
  DISABLED
  AUTO_ARCHIVED
  RESTORED
  PENDING_APPROVAL
  ZERO_ACTIVE
  CONTRIBUTION_ACTIVE
  SUSPENDED
  CLOSED_EXPIRED
}

enum CommissionStatus {
  PENDING
  CONFIRMED
  PROCESSED
  PAID
  REVERSED
}

enum NotificationType {
  SYSTEM
  FINANCE
  SECURITY
}

enum NotificationPriority {
  HIGH
  MEDIUM
  LOW
}

enum InvestmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  FULLY_WITHDRAWN
}

enum WithdrawalType {
  PARTIAL
  FULL
}

enum HoldingLedgerType {
  WITHHOLDING
  AUTO_CONVERSION
  ADJUSTMENT
}

enum RegistrationStatus {
  DRAFT
  PENDING_REVIEW
  PENDING_ADMIN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum SmsStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
}

model Shareholder {
  id               String   @id @default(uuid())
  name             String   @default("")
  shareholderId    String   @unique
  phone            String?
  passwordHash     String
  role             Role     @default(SHAREHOLDER)
  status           UserStatus @default(ACTIVE)
  accountType      AccountType @default(CONTRIBUTION)
  referralCode     String   @unique
  
  parentId         String?
  parent           Shareholder?    @relation("ReferralHierarchy", fields: [parentId], references: [id])
  children         Shareholder[]   @relation("ReferralHierarchy")
  
  holdingBalance   Decimal  @default(0) @db.Decimal(19, 4)
  withholdingPercentage Decimal? @default(20) @db.Decimal(5, 2)
  unlockedLevelOverride Int?
  currentRank      String?  // Bronze, Silver, Gold, Diamond
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  dob               DateTime?
  
  // PAN Details
  pan               String?

  // Admin Module-level Permissions (for role ADMIN)
  permissions       Json?

  // Complete Address
  addressBuilding   String?
  addressArea       String?
  addressCity       String?
  addressDistrict   String?
  addressPincode    String?
  addressState      String?

  // Bank Details
  bankAccountName   String?
  bankAccountNumber String?
  bankName          String?
  bankBranch        String?
  bankIfsc          String?

  disabledAt        DateTime?
  
  investments          Investment[]
  profitLedgers        ProfitLedger[]
  commissionLedgers    CommissionLedger[]
  payoutDetails        PayoutDetail[]
  notifications        Notification[]
  contributions        Contribution[]
  sentMessages         Message[]              @relation("SentMessages")
  receivedMessages     Message[]              @relation("ReceivedMessages")
  announcementReads    AnnouncementRead[]
  investorProfile      InvestorProfile?
  contributionSummary  ContributionSummary?
  referrerRelations    ReferralRelationship[] @relation("ReferrerRel")
  referredRelation     ReferralRelationship?  @relation("ReferredRel")
  commissionsSourced   CommissionLedger[]     @relation("CommissionSource")
  withdrawals          Withdrawal[]
  withdrawalsProcessed Withdrawal[]           @relation("WithdrawalProcessor")
  
  // Product 360 Relations
  holdingLedgers           HoldingLedger[]
  unlockOverridesReceived  AccountUnlockOverride[] @relation("OverrideUser")
  unlockOverridesCreated   AccountUnlockOverride[] @relation("OverrideAdmin")
  userRankHistories        UserRankHistory[]
  referralRegistrations    RegistrationRequest[]   @relation("ReferrerRegistrations")
  reviewedRegistrations    RegistrationRequest[]   @relation("ReviewedRegistrations")
  smsLogs                  SmsLog[]
  financialChangeRequests  FinancialChangeRequest[]
  reviewedFinancialRequests FinancialChangeRequest[] @relation("ReviewedFinancialRequests")

  @@map("User")
  @@index([parentId])
  @@index([status])
  @@index([accountType])
  @@index([phone])
  @@index([pan])
}

model Investment {
  id              String   @id @default(uuid())
  shareholderId   String
  shareholder     Shareholder     @relation(fields: [shareholderId], references: [id])
  amount          Decimal  @db.Decimal(19, 4)
  dailyProfitRate Decimal  @db.Decimal(5, 4)
  status          InvestmentStatus @default(PENDING)
  startDate       DateTime @default(now())
  validityMonths  Int      @default(12)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  profitLedgers   ProfitLedger[]
  commissionLedgers CommissionLedger[]
  withdrawals     Withdrawal[]

  @@index([shareholderId])
  @@index([status])
}

model Withdrawal {
  id                  String         @id @default(uuid())
  withdrawalId        String         @unique
  shareholderId       String
  shareholder         Shareholder    @relation(fields: [shareholderId], references: [id], onDelete: Cascade)
  investmentId        String?
  investment          Investment?    @relation(fields: [investmentId], references: [id])
  type                WithdrawalType
  amount              Decimal        @db.Decimal(19, 4)
  previousActiveFund  Decimal        @db.Decimal(19, 4)
  remainingActiveFund Decimal        @db.Decimal(19, 4)
  withdrawalDate      DateTime       @default(now())
  processedById       String?
  processedBy         Shareholder?   @relation("WithdrawalProcessor", fields: [processedById], references: [id])
  remarks             String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([shareholderId])
  @@index([investmentId])
}

model ProfitLedger {
  id              String   @id @default(uuid())
  shareholderId   String
  shareholder     Shareholder     @relation(fields: [shareholderId], references: [id])
  investmentId    String?
  investment      Investment? @relation(fields: [investmentId], references: [id])
  contributionId  String?
  contribution    Contribution? @relation(fields: [contributionId], references: [id])
  
  cycleStart      DateTime
  cycleEnd        DateTime
  cycleIdentifier String?
  eligibleDays    Int
  isFirstPayout   Boolean  @default(false)
  activeDays      Int?
  dailyRate       Decimal? @db.Decimal(9, 6)
  rateBasis       String?  @default("MONTH_DAYS")
  amount          Decimal  @db.Decimal(19, 4)
  profitShareRate Decimal? @db.Decimal(5, 4)
  configVersionId String?
  status          PayoutStatus @default(PENDING)
  payoutBatchId   String?
  payoutBatch     PayoutBatch? @relation(fields: [payoutBatchId], references: [id])
  
  createdAt       DateTime @default(now())

  @@index([shareholderId])
  @@index([investmentId])
  @@index([contributionId])
  @@index([payoutBatchId])
  @@index([cycleStart, cycleEnd])
  @@index([cycleIdentifier])
}

model CommissionLedger {
  id               String   @id @default(uuid())
  shareholderId    String
  shareholder      Shareholder     @relation(fields: [shareholderId], references: [id])
  fromInvestmentId String?
  fromInvestment   Investment? @relation(fields: [fromInvestmentId], references: [id])
  fromContributionId String?
  fromContribution   Contribution? @relation(fields: [fromContributionId], references: [id])
  
  cycleIdentifier  String?
  level            Int
  rate             Decimal  @db.Decimal(5, 4)
  amount           Decimal  @db.Decimal(19, 4)
  gratitudeShareRate Decimal? @db.Decimal(5, 4)
  calculationBase  Decimal? @db.Decimal(19, 4)
  configVersionId  String?
  status           CommissionStatus @default(PENDING)
  payoutBatchId    String?
  payoutBatch      PayoutBatch? @relation(fields: [payoutBatchId], references: [id])
  
  createdAt        DateTime @default(now())

  sourceShareholderId String?
  sourceShareholder   Shareholder? @relation("CommissionSource", fields: [sourceShareholderId], references: [id])

  @@index([shareholderId])
  @@index([fromInvestmentId])
  @@index([fromContributionId])
  @@index([payoutBatchId])
  @@index([level])
  @@index([cycleIdentifier])
}

model PayoutBatch {
  id                  String       @id @default(uuid())
  idempotencyKey      String?      @unique
  cycleIdentifier     String?      @unique
  cycleNumber         Int          @default(1)
  cycleStart          DateTime
  cycleEnd            DateTime
  cutoffDate          DateTime?
  payoutDate          DateTime?
  status              BatchStatus  @default(PENDING)
  totalAmount         Decimal      @db.Decimal(19, 4)
  totalGrossProfit    Decimal      @default(0) @db.Decimal(19, 4)
  totalGrossGratitude Decimal      @default(0) @db.Decimal(19, 4)
  totalWithheld       Decimal      @default(0) @db.Decimal(19, 4)
  totalNetPayable     Decimal      @default(0) @db.Decimal(19, 4)
  totalBeneficiaries  Int          @default(0)
  calculationVersion  Int          @default(1)
  configVersionId     String?
  reversalReason      String?
  reversedAt          DateTime?
  reversedById        String?
  
  approvedAt          DateTime?
  releasedAt          DateTime?
  
  details             PayoutDetail[]
  profitLedgers       ProfitLedger[]
  commissions         CommissionLedger[]
  holdingLedgers      HoldingLedger[]
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([cycleStart, cycleEnd])
  @@index([status])
  @@index([cycleIdentifier])
}

enum BatchStatus {
  PENDING
  REVIEWED
  APPROVED
  RELEASED
  REJECTED
  REVERSED
}

model PayoutDetail {
  id                  String   @id @default(uuid())
  batchId             String
  batch               PayoutBatch @relation(fields: [batchId], references: [id])
  shareholderId       String
  shareholder         Shareholder        @relation(fields: [shareholderId], references: [id])
  
  // Backward compatibility fields
  profitAmount        Decimal  @db.Decimal(19, 4)
  commissionAmount    Decimal  @db.Decimal(19, 4)
  totalAmount         Decimal  @db.Decimal(19, 4)
  
  // Product 360 statement fields
  isFirstPayout       Boolean  @default(false)
  activeDays          Int?
  dailyRate           Decimal? @db.Decimal(9, 6)
  prorationBasis      String?
  effectiveLevel      Int      @default(1)
  grossProfitShare    Decimal  @default(0) @db.Decimal(19, 4)
  grossGratitudeShare Decimal  @default(0) @db.Decimal(19, 4)
  withheldAmount      Decimal  @default(0) @db.Decimal(19, 4)
  deductions          Decimal  @default(0) @db.Decimal(19, 4)
  netPayable          Decimal  @default(0) @db.Decimal(19, 4)
  calculationVersion  Int      @default(1)
  configVersionId     String?
  
  status              PayoutStatus @default(PENDING)
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([batchId, shareholderId], name: "unique_batch_shareholder_detail")
  @@index([batchId])
  @@index([shareholderId])
  @@index([status])
}

enum PayoutStatus {
  PENDING
  PROCESSED
  PAID
  FAILED
  REVERSED
}

model SystemSetting {
  key             String   @id
  value           String
  updatedAt       DateTime @updatedAt
}

model AuditLog {
  id              String   @id @default(uuid())
  shareholderId   String?
  role            String?
  action          String
  entityType      String
  entityId        String?
  oldValue        String?
  newValue        String?
  reason          String?
  ipAddress       String?
  
  createdAt       DateTime @default(now())

  @@index([shareholderId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model Notification {
  id              String   @id @default(uuid())
  shareholderId   String
  shareholder     Shareholder     @relation(fields: [shareholderId], references: [id], onDelete: Cascade)
  title           String
  message         String
  isRead          Boolean  @default(false)
  isArchived      Boolean  @default(false)
  isDeleted       Boolean  @default(false)
  type            NotificationType @default(SYSTEM)
  priority        NotificationPriority @default(MEDIUM)
  
  createdAt       DateTime @default(now())

  @@index([shareholderId])
  @@index([isRead])
}

model Contribution {
  id              String             @id @default(uuid())
  shareholderId   String
  shareholder     Shareholder        @relation(fields: [shareholderId], references: [id], onDelete: Cascade)
  amount          Decimal            @db.Decimal(19, 4)
  mode            String             // Cash, Bank Transfer, Cheque, Holding Activation
  date            DateTime
  issuedAgreement Boolean            @default(false)
  issuedCheque    Boolean            @default(false)
  status          ContributionStatus @default(PENDING)
  validityMonths  Int                @default(12)
  
  // Product 360 fields
  paymentProofUrl  String?
  paymentProofFile String?
  approvedById     String?
  approvedAt       DateTime?
  effectiveDate    DateTime?
  activeDate       DateTime?
  isAutoConverted  Boolean            @default(false)
  rejectionReason  String?
  
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  profitLedgers    ProfitLedger[]
  commissionLedgers CommissionLedger[]

  @@index([shareholderId])
  @@index([status])
  @@index([date])
}

model HoldingLedger {
  id              String             @id @default(uuid())
  shareholderId   String
  shareholder     Shareholder        @relation(fields: [shareholderId], references: [id], onDelete: Cascade)
  payoutBatchId   String?
  payoutBatch     PayoutBatch?       @relation(fields: [payoutBatchId], references: [id])
  amount          Decimal            @db.Decimal(19, 4)
  balanceBefore   Decimal            @db.Decimal(19, 4)
  balanceAfter    Decimal            @db.Decimal(19, 4)
  type            HoldingLedgerType
  remarks         String?
  createdAt       DateTime           @default(now())

  @@index([shareholderId])
  @@index([payoutBatchId])
  @@index([type])
}

model AccountUnlockOverride {
  id              String             @id @default(uuid())
  shareholderId   String
  shareholder     Shareholder        @relation("OverrideUser", fields: [shareholderId], references: [id], onDelete: Cascade)
  previousLevel   Int
  newLevel        Int
  reason          String
  remark          String?
  createdById     String
  createdBy       Shareholder        @relation("OverrideAdmin", fields: [createdById], references: [id])
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([shareholderId])
  @@index([createdById])
}

model RankConfiguration {
  id                  String         @id @default(uuid())
  name                String         @unique // Bronze, Silver, Gold, Diamond
  requiredVolume      Decimal        @db.Decimal(19, 4)
  maxStrongestLeg     Decimal        @db.Decimal(19, 4)
  minOtherLegs        Decimal        @db.Decimal(19, 4)
  orderIndex          Int            @default(1)
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model UserRankHistory {
  id                  String         @id @default(uuid())
  shareholderId       String
  shareholder         Shareholder    @relation(fields: [shareholderId], references: [id], onDelete: Cascade)
  rankName            String
  teamVolume          Decimal        @db.Decimal(19, 4)
  achievedAt          DateTime       @default(now())

  @@index([shareholderId])
}

model RegistrationRequest {
  id                  String             @id @default(uuid())
  name                String
  phone               String
  pan                 String?
  accountType         AccountType        @default(CONTRIBUTION)
  referrerId          String?
  referrer            Shareholder?       @relation("ReferrerRegistrations", fields: [referrerId], references: [id])
  contributionAmount  Decimal?           @db.Decimal(19, 4)
  paymentProofUrl     String?
  paymentProofFileName String?

  // Complete Address details
  dob                 DateTime?
  addressBuilding     String?
  addressArea         String?
  addressCity         String?
  addressDistrict     String?
  addressPincode      String?
  addressState        String?

  // Bank Details
  bankAccountName     String?
  bankAccountNumber   String?
  bankName            String?
  bankBranch          String?
  bankIfsc            String?

  // Date of Investment & Credentials
  contributionDate    DateTime?
  initialPassword     String?

  status              RegistrationStatus @default(PENDING_REVIEW)
  withholdingPercentage Decimal?         @default(20) @db.Decimal(5, 2)
  rejectionReason     String?
  reviewedById        String?
  reviewedBy          Shareholder?       @relation("ReviewedRegistrations", fields: [reviewedById], references: [id])
  reviewedAt          DateTime?
  createdShareholderId String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([status])
  @@index([referrerId])
  @@index([phone])
}

enum FinancialRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model FinancialChangeRequest {
  id                String                 @id @default(uuid())
  shareholderId     String
  shareholder       Shareholder            @relation(fields: [shareholderId], references: [id], onDelete: Cascade)
  
  bankAccountName   String?
  bankAccountNumber String?
  bankName          String?
  bankBranch        String?
  bankIfsc          String?
  pan               String?

  status            FinancialRequestStatus @default(PENDING)
  rejectionReason   String?
  
  reviewedById      String?
  reviewedBy        Shareholder?           @relation("ReviewedFinancialRequests", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?

  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([shareholderId])
  @@index([status])
}

enum OtpPurpose {
  FORGOT_PASSWORD
  CHANGE_PASSWORD
}

model OtpVerification {
  id          String      @id @default(uuid())
  identifier  String      // phone or shareholderId
  otp         String
  purpose     OtpPurpose  @default(FORGOT_PASSWORD)
  expiresAt   DateTime
  isUsed      Boolean     @default(false)
  resetToken  String?     @unique
  createdAt   DateTime    @default(now())

  @@index([identifier])
  @@index([otp])
  @@index([resetToken])
}

model SmsLog {
  id                  String             @id @default(uuid())
  recipient           String
  shareholderId       String?
  shareholder         Shareholder?       @relation(fields: [shareholderId], references: [id])
  message             String
  template            String?
  provider            String             @default("MOCK_GATEWAY")
  providerResponse    String?
  status              SmsStatus          @default(SENT)
  retryCount          Int                @default(0)
  createdAt           DateTime           @default(now())

  @@index([recipient])
  @@index([shareholderId])
  @@index([status])
}

model ReconciliationLog {
  id                  String             @id @default(uuid())
  checkType           String             // CONTRIBUTIONS, PROFITS, GRATITUDE, HOLDING, PAYOUTS
  expectedValue       Decimal            @db.Decimal(19, 4)
  actualValue         Decimal            @db.Decimal(19, 4)
  difference          Decimal            @db.Decimal(19, 4)
  status              String             // BALANCED, DISCREPANCY
  details             Json?
  createdAt           DateTime           @default(now())

  @@index([checkType])
  @@index([status])
}

model BusinessConfiguration {
  id                        String   @id @default(uuid())
  version                   Int      @default(1)
  userIdPrefix              String   @default("USR")
  userIdStartingNumber      Int      @default(1)
  userIdNextNumber          Int      @default(1)
  userIdLength              Int      @default(6)
  levelOpeningVolume        Json?
  profitSharingPercentage   Decimal? @db.Decimal(5, 4)
  levelWiseProfitSharing    Json?
  referralLevelSettings     Json?
  systemDefaults            Json?
  futureBusinessParameters  Json?
  
  // Product 360 centralized configuration JSONs
  gratitudeShareConfig      Json?    // L1-L12 percentages
  levelUnlockConfig         Json?    // 1 direct -> L3, 2 -> L6, 3 -> L9, 4 -> L12
  rankConfig                Json?    // Bronze, Silver, Gold, Diamond rules
  payoutConfig              Json?    // Calendar cutoff dates
  prorationConfig           Json?    // Pending client confirmation settings
  
  createdById               String
  createdAt                 DateTime @default(now())

  @@index([version])
}

model Announcement {
  id            String             @id @default(uuid())
  title         String
  content       String             // HTML/Rich text
  imageUrl      String?
  attachmentUrl String?
  priority      String             // HIGH, MEDIUM, LOW
  audience      String             // EVERYONE, ADMINS, SHAREHOLDERS, INDIVIDUAL_USER
  targetUserId  String?
  pinned        Boolean            @default(false)
  scheduledFor  DateTime?
  expiresAt     DateTime?
  status        String             // DRAFT, PUBLISHED, EXPIRED, ARCHIVED
  createdBy     String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  reads         AnnouncementRead[]
}

model AnnouncementRead {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  shareholderId  String
  shareholder    Shareholder  @relation(fields: [shareholderId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([announcementId, shareholderId])
}

model Message {
  id                   String              @id @default(uuid())
  senderId             String
  sender               Shareholder         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId          String
  recipient            Shareholder         @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  subject              String?
  content              String
  parentMessageId      String?
  parentMessage        Message?            @relation("MessageThread", fields: [parentMessageId], references: [id])
  replies              Message[]           @relation("MessageThread")
  isDraft              Boolean             @default(false)
  isRead               Boolean             @default(false)
  isStarredBySender    Boolean             @default(false)
  isStarredByRecipient Boolean             @default(false)
  isDeletedBySender    Boolean             @default(false)
  isDeletedByRecipient Boolean             @default(false)
  isArchivedBySender   Boolean             @default(false)
  isArchivedByRecipient Boolean            @default(false)
  createdAt            DateTime            @default(now())
  attachments          MessageAttachment[]
}

model MessageAttachment {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName  String
  fileUrl   String
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())
}

model FounderArticle {
  id           String                  @id @default(uuid())
  title        String
  slug         String                  @unique
  content      String
  coverImage   String?
  seoTitle     String?
  seoDesc      String?
  seoKeywords  String?
  status       String                  // DRAFT, PUBLISHED, SCHEDULED, ARCHIVED
  version      Int                     @default(1)
  scheduledFor DateTime?
  publishedAt  DateTime?
  createdBy    String
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  history      FounderArticleHistory[]
}

model FounderArticleHistory {
  id        String         @id @default(uuid())
  articleId String
  article   FounderArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  title     String
  content   String
  version   Int
  updatedBy String
  updatedAt DateTime       @default(now())
}

model JwtBlacklist {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model BusinessVolume {
  id            String   @id @default(uuid())
  shareholderId String
  level         Int
  totalVolume   Decimal  @db.Decimal(19, 4)
  updatedAt     DateTime @updatedAt

  @@unique([shareholderId, level])
}

enum ProfitSharingType {
  PERCENT
  FIXED
}

model LevelConfiguration {
  id              String            @id @default(uuid())
  levelNumber     Int               @unique
  volumeThreshold Decimal           @db.Decimal(19, 4)
  profitType      ProfitSharingType @default(PERCENT)
  profitValue     Decimal           @db.Decimal(19, 4)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

enum CalculationStatus {
  PENDING
  PROCESSED
  FAILED
}

model ProfitCalculation {
  id            String            @id @default(uuid())
  shareholderId String
  level         Int
  volume        Decimal           @db.Decimal(19, 4)
  profitAmount  Decimal           @db.Decimal(19, 4)
  batchId       String?
  status        CalculationStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

enum ContributionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InvestorStatus {
  ACTIVE
  INACTIVE
  DISABLED
  ARCHIVED
  DELETED
}

model InvestorProfile {
  id           String         @id @default(uuid())
  shareholderId String        @unique
  shareholder   Shareholder   @relation(fields: [shareholderId], references: [id], onDelete: Cascade)
  status       InvestorStatus @default(ACTIVE)
  activatedAt  DateTime       @default(now())
  investorType String         @default("STANDARD")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model ReferralRelationship {
  id           String   @id @default(uuid())
  parentId     String
  childId      String   @unique
  parent       Shareholder     @relation("ReferrerRel", fields: [parentId], references: [id])
  child        Shareholder     @relation("ReferredRel", fields: [childId], references: [id], onDelete: Cascade)
  referralDate DateTime @default(now())
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([parentId])
}

model ContributionSummary {
  id            String   @id @default(uuid())
  shareholderId String   @unique
  shareholder   Shareholder     @relation(fields: [shareholderId], references: [id], onDelete: Cascade)
  totalApproved Decimal  @db.Decimal(19, 4) @default(0)
  totalPending  Decimal  @db.Decimal(19, 4) @default(0)
  totalRejected Decimal  @db.Decimal(19, 4) @default(0)
  lastUpdated   DateTime @default(now())
}

model ProfitConfiguration {
  id                  String   @id @default(uuid())
  version             Int      @default(1)
  maxReferralLevels   Int      @default(12)
  levelOpeningVolumes Json     // e.g. {"1": 10000, "2": 25000}
  levelPercentages    Json     // e.g. {"1": 0.01, "2": 0.005}
  effectiveDate       DateTime @default(now())
  status              String   @default("ACTIVE") // ACTIVE, INACTIVE, DRAFT
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}


