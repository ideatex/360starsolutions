{
  "name": "360-star-solutions",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:next": "next dev src/client",
    "dev:nest": "node --env-file=.env node_modules/@nestjs/cli/bin/nest.js start --watch",
    "dev": "concurrently \"npm run dev:next\" \"npm run dev:nest\"",
    "build:client": "next build src/client && node -e \"const fs=require('fs'); if(fs.existsSync('dist/client')) fs.rmSync('dist/client', {recursive:true, force:true}); fs.mkdirSync('dist', {recursive:true}); fs.cpSync('src/client/out', 'dist/client', {recursive:true});\"",
    "build:server": "nest build",
    "build": "npm run build:client && npm run build:server",
    "start": "node --env-file=.env dist/server/main.js",
    "postinstall": "node -e \"if(require('fs').existsSync('postinstall.js')) require('./postinstall.js')\""
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.27",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/websockets": "^11.1.27",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.101.1",
    "@xyflow/react": "^12.11.1",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.79.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.2",
    "framer-motion": "^12.42.0",
    "lucide-react": "^1.21.0",
    "next": "15.5.19",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "radix-ui": "^1.6.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.80.0",
    "recharts": "^3.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "shadcn": "^4.12.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@types/bcryptjs": "^2.4.6",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.0.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.19",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
